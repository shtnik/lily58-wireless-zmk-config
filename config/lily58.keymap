#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 3 1 0 2 4 29 17 16 15 14 13 12 24 25 26 27 28 42 53 51 52 50 36 37 39 38 40 41 54 55 56 57>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <53 52 51 50 6 7 8 9 10 11 23 22 21 20 19 18 30 43 31 33 32 34 35 49 48 47 44 45 46 57 56 55 54>;
        };

        shit_caps: shit_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIT_CAPS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lpar_comb {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        rpar_comb {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        lbkt_comb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        rbkt_comb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };

        lbrc_comb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <40 41>;
        };

        rbrc_comb {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <44 45>;
        };

        pipe_comb {
            bindings = <&kp PIPE>;
            key-positions = <31 32>;
        };

        bsl_comb {
            bindings = <&kp BACKSLASH>;
            key-positions = <32 33>;
        };

        tld_comb {
            bindings = <&kp TILDE>;
            key-positions = <27 28>;
        };

        grv_comb {
            bindings = <&kp GRAVE>;
            key-positions = <27 26>;
        };

        pls_comb {
            bindings = <&kp PLUS>;
            key-positions = <40 39>;
        };

        ast_comb {
            bindings = <&kp ASTERISK>;
            key-positions = <39 38>;
        };

        mns_comb {
            bindings = <&kp MINUS>;
            key-positions = <45 46>;
        };

        uds_comb {
            bindings = <&kp UNDERSCORE>;
            key-positions = <46 47>;
        };

        eq_comb {
            bindings = <&kp EQUAL>;
            key-positions = <31 32 33>;
        };

        exc_comb {
            bindings = <&kp EXCLAMATION>;
            key-positions = <28 27 26>;
        };

        dlr_comb {
            bindings = <&kp DOLLAR>;
            key-positions = <31 20>;
        };

        crt_comb {
            bindings = <&kp CARET>;
            key-positions = <28 15>;
        };

        hsh_comb {
            bindings = <&kp HASH>;
            key-positions = <16 15>;
        };

        pct_comb {
            bindings = <&kp PERCENT>;
            key-positions = <20 19>;
        };

        at_comb {
            bindings = <&kp AT>;
            key-positions = <15 14>;
        };

        amp_comb {
            bindings = <&kp AMPERSAND>;
            key-positions = <20 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC       &kp N1             &kp N2               &kp N3            &kp N4               &kp N5                           &kp N6         &kp N7                &kp N8            &kp N9                &kp N0                      &kp DELETE
&kp CAPSLOCK  &kp Q              &kp W                &kp E             &kp R                &kp T                            &kp Y          &kp U                 &kp I             &kp O                 &kp P                       &kp LEFT_BRACKET
&kp TAB       &hml LEFT_SHIFT A  &hml LEFT_CONTROL S  &hml LEFT_ALT D   &hml LEFT_COMMAND F  &kp G                            &kp H          &hmr RIGHT_COMMAND J  &hmr RIGHT_ALT K  &hmr RIGHT_CONTROL L  &hmr RIGHT_SHIFT SEMICOLON  &kp SQT
&shit_caps    &kp Z              &kp X                &kp C             &kp V                &kp B   &lt 3 K_MUTE    &mo 4    &kp N          &kp M                 &kp COMMA         &kp DOT               &kp FSLH                    &kp RIGHT_BRACKET
                                                      &kp LEFT_CONTROL  &kp LGUI             &mo 1   &kp SPACE       &kp RET  &kp BACKSPACE  &mo 2                 &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF                    &kp C_PREV  &kp C_PP  &kp C_NEXT    &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp F1                &kp F2                &kp F3           &kp F4           &kp F5           &kp F6                             &kp F7      &kp F8    &kp F9        &kp F10     &kp F11            &kp F12
&trans                &trans                &trans           &trans           &trans           &trans                             &kp LEFT    &kp DOWN  &kp UP_ARROW  &kp RIGHT   &trans             &trans
&trans                &trans                &trans           &trans           &trans           &trans           &trans    &trans  &trans      &trans    &trans        &trans      &trans             &trans
                                                             &trans           &trans           &trans           &trans    &trans  &trans      &trans    &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp HOME  &kp PG_UP                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp END   &kp PG_DN  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans     &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        music {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        brightness {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_COLOR_HSB(178,100,50)                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                             &kp K_COFFEE    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                             &trans          &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        f_keys {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans  &kp DEL  &kp RALT  &kp RCTRL  &kp RSHFT  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &trans  &trans   &trans    &trans     &trans     &trans
&trans  &trans  &trans  &trans   &trans   &trans                     &trans  &trans   &trans    &trans     &trans     &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans   &trans    &trans     &trans     &trans
                        &trans   &trans   &trans   &trans    &trans  &trans  &trans   &trans
            >;
        };
    };
};
